package com.example.studentmanagement.helpers;

import org.springframework.context.annotation.Configuration;
import org.springframework.web.servlet.config.annotation.CorsRegistry;
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;

@Configuration
public class WebConfig implements WebMvcConfigurer {

    @Override
    public void addCorsMappings(CorsRegistry registry) {
        registry.addMapping("/**") // Tüm endpointler için geçerli
                .allowedOrigins("http://localhost:3000") // Frontend adresi
                .allowedMethods("*") // Tüm HTTP metotlarına izin
                .allowedHeaders("*") // Tüm başlıklara izin
                .allowCredentials(true); // Kimlik doğrulama bilgileri (ör. çerezler) için izin
    }
}
